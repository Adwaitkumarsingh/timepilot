<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TimePilot - Smart Study Scheduler</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Monoton&family=Chakra+Petch:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --void: #0a0014;
      --void-2: #150022;
      --panel: rgba(19, 8, 34, 0.78);
      --panel-border: rgba(255, 45, 149, 0.28);
      --neon-pink: #ff2d95;
      --neon-cyan: #00e5ff;
      --neon-purple: #a742ff;
      --neon-acid: #ccff00;
      --text-light: #f5eaff;
      --text-dim: #b6a2d9;
      --font-display: 'Monoton', cursive;
      --font-head: 'Chakra Petch', sans-serif;
      --font-mono: 'Space Mono', monospace;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: var(--font-head);
      background:
        radial-gradient(circle at 12% 8%, rgba(255, 45, 149, 0.28), transparent 42%),
        radial-gradient(circle at 88% 18%, rgba(0, 229, 255, 0.22), transparent 42%),
        radial-gradient(circle at 50% 95%, rgba(167, 66, 255, 0.25), transparent 50%),
        linear-gradient(180deg, var(--void) 0%, var(--void-2) 55%, #1a0030 100%);
      background-attachment: fixed;
      min-height: 100vh;
      padding: 20px;
      color: var(--text-light);
      position: relative;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(0, 229, 255, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 45, 149, 0.07) 1px, transparent 1px);
      background-size: 42px 42px;
      pointer-events: none;
      z-index: 0;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    header {
      background: var(--panel);
      backdrop-filter: blur(12px);
      padding: 25px;
      border-radius: 12px;
      border: 1px solid var(--panel-border);
      box-shadow: 0 0 25px rgba(255, 45, 149, 0.25), 0 0 55px rgba(0, 229, 255, 0.08);
      margin-bottom: 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }

    header h1 {
      font-family: var(--font-display);
      color: var(--neon-pink);
      text-shadow: 0 0 6px var(--neon-pink), 0 0 18px rgba(255, 45, 149, 0.7), 0 0 40px rgba(255, 45, 149, 0.4);
      font-size: 26px;
      letter-spacing: 2px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 400;
    }

    header h1 i {
      color: var(--neon-cyan);
      text-shadow: 0 0 6px var(--neon-cyan), 0 0 16px rgba(0, 229, 255, 0.8);
      font-size: 22px;
    }

    .header-actions {
      display: flex;
      gap: 15px;
    }

    button {
      background: linear-gradient(135deg, var(--neon-pink), var(--neon-purple));
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 10px 20px;
      border-radius: 8px;
      cursor: pointer;
      font-family: var(--font-head);
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.25s ease;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 0 12px rgba(255, 45, 149, 0.45);
    }

    button:hover {
      background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
      transform: translateY(-2px);
      box-shadow: 0 0 22px rgba(0, 229, 255, 0.65);
    }

    button.secondary {
      background: transparent;
      color: var(--neon-cyan);
      border: 1px solid var(--neon-cyan);
      box-shadow: 0 0 8px rgba(0, 229, 255, 0.25);
    }

    button.secondary:hover {
      background: rgba(0, 229, 255, 0.15);
      color: #fff;
      box-shadow: 0 0 18px rgba(0, 229, 255, 0.5);
    }

    .tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 30px;
      border-bottom: 1px solid var(--panel-border);
      background: var(--panel);
      backdrop-filter: blur(12px);
      padding: 15px 25px;
      border-radius: 12px;
      border: 1px solid var(--panel-border);
      box-shadow: 0 0 20px rgba(167, 66, 255, 0.15);
    }

    .tab-button {
      padding: 12px 24px;
      background: transparent;
      color: var(--text-dim);
      border: none;
      border-bottom: 3px solid transparent;
      cursor: pointer;
      font-family: var(--font-head);
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.3s ease;
    }

    .tab-button.active {
      color: var(--neon-cyan);
      border-bottom-color: var(--neon-cyan);
      text-shadow: 0 0 8px rgba(0, 229, 255, 0.8);
    }

    .tab-button:hover {
      color: var(--neon-pink);
      transform: none;
    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    .dashboard {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 25px;
      margin-bottom: 30px;
    }

    .card {
      background: var(--panel);
      backdrop-filter: blur(12px);
      padding: 25px;
      border-radius: 12px;
      border: 1px solid var(--panel-border);
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
      transition: all 0.3s ease;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: rgba(0, 229, 255, 0.5);
      box-shadow: 0 0 30px rgba(0, 229, 255, 0.25);
    }

    .card h2 {
      color: var(--neon-pink);
      margin-bottom: 15px;
      font-size: 17px;
      font-family: var(--font-head);
      text-transform: uppercase;
      letter-spacing: 1px;
      text-shadow: 0 0 6px rgba(255, 45, 149, 0.45);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .input-group {
      margin-bottom: 15px;
    }

    .input-group label {
      display: block;
      margin-bottom: 8px;
      color: var(--text-dim);
      font-weight: 600;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .input-group input,
    .input-group select {
      width: 100%;
      padding: 10px;
      background: rgba(8, 3, 16, 0.6);
      border: 1px solid rgba(167, 66, 255, 0.35);
      border-radius: 6px;
      font-size: 14px;
      font-family: var(--font-mono);
      color: var(--text-light);
      transition: border-color 0.3s, box-shadow 0.3s;
    }

    .input-group input:focus,
    .input-group select:focus {
      outline: none;
      border-color: var(--neon-cyan);
      box-shadow: 0 0 10px rgba(0, 229, 255, 0.4);
    }

    .badges-container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      max-height: 420px;
      overflow-y: auto;
      padding-right: 4px;
    }

    .badge-card {
      background: rgba(8, 3, 16, 0.6);
      padding: 20px;
      border-radius: 10px;
      text-align: center;
      cursor: pointer;
      transition: all 0.3s ease;
      border: 1px solid rgba(167, 66, 255, 0.25);
      opacity: 0.45;
    }

    .badge-card:hover {
      transform: scale(1.05);
      border-color: var(--neon-cyan);
    }

    .badge-card.unlocked {
      background: linear-gradient(135deg, rgba(255, 45, 149, 0.25), rgba(0, 229, 255, 0.2));
      border-color: var(--neon-acid);
      box-shadow: 0 0 18px rgba(204, 255, 0, 0.35);
      opacity: 1;
    }

    .badge-icon {
      font-size: 34px;
      margin-bottom: 10px;
    }

    .badge-name {
      font-weight: 700;
      color: var(--text-light);
      margin-bottom: 5px;
      font-family: var(--font-head);
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge-status {
      font-size: 11px;
      color: var(--text-dim);
      font-weight: 600;
      font-family: var(--font-mono);
      text-transform: uppercase;
    }

    .timetable {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 10px;
      margin-top: 15px;
    }

    .day-slot {
      background: rgba(8, 3, 16, 0.6);
      padding: 15px;
      border-radius: 8px;
      text-align: center;
      border-left: 3px solid var(--neon-cyan);
      border-top: 1px solid rgba(167, 66, 255, 0.2);
      border-right: 1px solid rgba(167, 66, 255, 0.2);
      border-bottom: 1px solid rgba(167, 66, 255, 0.2);
    }

    .day-slot strong {
      display: block;
      color: var(--neon-cyan);
      margin-bottom: 5px;
      font-family: var(--font-head);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .day-slot small {
      color: var(--text-dim);
      font-family: var(--font-mono);
    }

    .stat {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      border-bottom: 1px solid rgba(167, 66, 255, 0.18);
      color: var(--text-dim);
      font-size: 14px;
    }

    .stat:last-child {
      border-bottom: none;
    }

    .stat-value {
      color: var(--neon-acid);
      font-weight: 700;
      font-size: 15px;
      font-family: var(--font-mono);
      text-shadow: 0 0 6px rgba(204, 255, 0, 0.5);
    }

    .focus-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 50% 40%, rgba(167, 66, 255, 0.25), transparent 60%), rgba(6, 2, 12, 0.96);
      z-index: 1000;
      justify-content: center;
      align-items: center;
      flex-direction: column;
    }

    .focus-overlay:not(.hidden) {
      display: flex;
    }

    .focus-overlay.hidden {
      display: none;
    }

    .focus-content {
      text-align: center;
      color: var(--text-light);
      font-family: var(--font-head);
    }

    .focus-timer-display {
      font-size: 120px;
      font-weight: bold;
      color: var(--neon-cyan);
      margin: 30px 0;
      font-family: var(--font-mono);
      text-shadow: 0 0 15px var(--neon-cyan), 0 0 40px rgba(0, 229, 255, 0.6);
    }

    .focus-controls {
      display: flex;
      gap: 20px;
      justify-content: center;
      margin-top: 30px;
    }

    .focus-controls button {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      font-size: 24px;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 0;
    }

    .focus-quit {
      background: linear-gradient(135deg, #ff2d95, #ff5252) !important;
    }

    .focus-quit:hover {
      background: #ff2d95 !important;
    }

    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(6, 2, 12, 0.85);
      backdrop-filter: blur(4px);
      z-index: 999;
      justify-content: center;
      align-items: center;
    }

    .modal.show {
      display: flex;
    }

    .modal-content {
      background: #120823;
      padding: 30px;
      border-radius: 12px;
      border: 1px solid var(--panel-border);
      max-width: 500px;
      width: 90%;
      box-shadow: 0 0 45px rgba(167, 66, 255, 0.4);
      max-height: 80vh;
      overflow-y: auto;
      color: var(--text-light);
    }

    .modal-content h2 {
      color: var(--neon-pink);
      margin-bottom: 20px;
      font-family: var(--font-head);
      text-transform: uppercase;
      letter-spacing: 1px;
      text-shadow: 0 0 6px rgba(255, 45, 149, 0.4);
    }

    .modal-content .form-group {
      margin-bottom: 15px;
    }

    .modal-content .form-group label {
      display: block;
      margin-bottom: 8px;
      color: var(--text-dim);
      font-weight: 600;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .modal-content .form-group input,
    .modal-content .form-group select {
      width: 100%;
      padding: 10px;
      background: rgba(8, 3, 16, 0.6);
      border: 1px solid rgba(167, 66, 255, 0.35);
      border-radius: 6px;
      font-size: 14px;
      font-family: var(--font-mono);
      color: var(--text-light);
    }

    .modal-content .form-group input:focus,
    .modal-content .form-group select:focus {
      outline: none;
      border-color: var(--neon-cyan);
      box-shadow: 0 0 10px rgba(0, 229, 255, 0.4);
    }

    .modal-actions {
      display: flex;
      gap: 10px;
      margin-top: 20px;
      justify-content: flex-end;
    }

    .modal-actions button {
      flex: 1;
    }

    .streak-display {
      font-size: 36px;
      color: var(--neon-acid);
      font-weight: bold;
      margin: 15px 0;
      text-align: center;
      font-family: var(--font-mono);
      text-shadow: 0 0 10px rgba(204, 255, 0, 0.5);
    }

    .info-box {
      background: rgba(167, 66, 255, 0.1);
      border-left: 4px solid var(--neon-purple);
      padding: 15px;
      border-radius: 6px;
      margin-top: 15px;
      color: var(--text-dim);
      font-size: 14px;
    }

    .progress-bar {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 4px;
      margin: 10px 0;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--neon-pink), var(--neon-cyan));
      box-shadow: 0 0 10px rgba(0, 229, 255, 0.6);
      transition: width 0.3s ease;
    }

    .chart-placeholder {
      background: rgba(8, 3, 16, 0.6);
      border: 1px solid rgba(167, 66, 255, 0.2);
      border-radius: 8px;
      padding: 40px;
      text-align: center;
      color: var(--text-dim);
      margin-top: 15px;
    }

    .school-timetable {
      background: rgba(8, 3, 16, 0.6);
      border-radius: 8px;
      padding: 20px;
      margin-top: 15px;
      overflow-x: auto;
    }

    .school-schedule-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 15px;
      margin-top: 15px;
    }

    .class-slot {
      background: linear-gradient(135deg, var(--neon-pink) 0%, var(--neon-purple) 100%);
      color: white;
      padding: 20px;
      border-radius: 10px;
      text-align: center;
      box-shadow: 0 0 15px rgba(255, 45, 149, 0.35);
    }

    .class-slot-time {
      font-weight: bold;
      font-size: 14px;
      margin-bottom: 8px;
      opacity: 0.9;
    }

    .class-slot-subject {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .class-slot-teacher {
      font-size: 12px;
      opacity: 0.8;
    }

    .generated-schedule {
      background: rgba(0, 229, 255, 0.06);
      border-left: 4px solid var(--neon-cyan);
      padding: 20px;
      border-radius: 8px;
      margin-top: 15px;
    }

    .schedule-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid rgba(167, 66, 255, 0.18);
    }

    .schedule-item:last-child {
      border-bottom: none;
    }

    .schedule-time {
      font-weight: 700;
      color: var(--neon-acid);
      min-width: 100px;
      font-family: var(--font-mono);
      text-shadow: 0 0 6px rgba(204, 255, 0, 0.4);
    }

    .schedule-activity {
      color: var(--text-light);
    }

    .schedule-duration {
      color: var(--text-dim);
      font-size: 12px;
      min-width: 80px;
      text-align: right;
      font-family: var(--font-mono);
    }

    .institution-card {
      background: rgba(8, 3, 16, 0.6);
      padding: 20px;
      border-radius: 8px;
      margin-bottom: 15px;
      border-left: 4px solid var(--neon-pink);
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
    }

    .institution-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .institution-name {
      font-weight: 700;
      color: var(--neon-cyan);
      font-size: 16px;
      font-family: var(--font-head);
    }

    .institution-time {
      color: var(--text-dim);
      font-size: 13px;
      font-family: var(--font-mono);
    }

    .remove-btn {
      background: linear-gradient(135deg, #ff2d95, #ff5252) !important;
      padding: 6px 12px;
      font-size: 12px;
      box-shadow: 0 0 10px rgba(255, 45, 149, 0.4);
    }

    .remove-btn:hover {
      background: #ff2d95 !important;
      box-shadow: 0 0 18px rgba(255, 45, 149, 0.6);
    }

    @media (max-width: 768px) {
      header {
        flex-direction: column;
        gap: 15px;
        text-align: center;
      }

      .dashboard {
        grid-template-columns: 1fr;
      }

      .focus-timer-display {
        font-size: 80px;
      }

      .header-actions {
        flex-wrap: wrap;
        justify-content: center;
      }

      .badges-container {
        grid-template-columns: 1fr;
      }

      .tabs {
        flex-wrap: wrap;
      }

      .tab-button {
        padding: 10px 16px;
        font-size: 13px;
      }
    }

    @media print {
      body {
        background: white !important;
        padding: 0;
        color: #222 !important;
      }

      body::before {
        display: none;
      }

      .header-actions,
      button,
      .modal,
      .tabs {
        display: none;
      }

      .dashboard {
        gap: 15px;
      }

      .card, header, .institution-card, .generated-schedule, .day-slot, .badge-card, .info-box {
        background: #f8f8f8 !important;
        border: 1px solid #ddd !important;
        box-shadow: none !important;
        color: #222 !important;
      }

      .card h2, header h1, .institution-name, .day-slot strong, .badge-name,
      .schedule-time, .stat-value, .streak-display {
        color: #444 !important;
        text-shadow: none !important;
      }

      .card {
        break-inside: avoid;
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header>
      <h1><i class="fas fa-clock"></i> TimePilot</h1>
      <div class="header-actions">
        <button onclick="openSettingsModal()"><i class="fas fa-cog"></i> Settings</button>
        <button class="secondary" onclick="triggerPrintPDF()"><i class="fas fa-print"></i> Export PDF</button>
      </div>
    </header>

    <!-- Tabs Navigation -->
    <div class="tabs">
      <button class="tab-button active" onclick="switchTab('dashboard')">
        <i class="fas fa-th-large"></i> Dashboard
      </button>
      <button class="tab-button" onclick="switchTab('school')">
        <i class="fas fa-school"></i> School/Academy
      </button>
      <button class="tab-button" onclick="switchTab('generated')">
        <i class="fas fa-calendar-check"></i> Generated Timetable
      </button>
    </div>

    <!-- Dashboard Tab -->
    <div id="dashboard" class="tab-content active">
      <div class="dashboard">
        <!-- Quick Stats Card -->
        <div class="card">
          <h2><i class="fas fa-chart-line"></i> Quick Stats</h2>
          <div class="stat">
            <span>📈 Current Streak</span>
            <span class="stat-value" id="streakDisplay">0 days</span>
          </div>
          <div class="stat">
            <span>⏰ Wake Time</span>
            <span class="stat-value" id="wakeTimeDisplay">7:00 AM</span>
          </div>
          <div class="stat">
            <span>🎯 Study Target</span>
            <span class="stat-value" id="studyTargetDisplay">0 hrs</span>
          </div>
          <div class="stat">
            <span>😴 Sleep Hours</span>
            <span class="stat-value" id="sleepHoursDisplay">0 hrs</span>
          </div>
          <button style="margin-top: 15px; width: 100%;" onclick="logTodaySession()">
            <i class="fas fa-check-circle"></i> Log Today's Session
          </button>
        </div>

        <!-- Badges Card -->
        <div class="card">
          <h2><i class="fas fa-trophy"></i> Achievements</h2>
          <div class="badges-container">
            <div class="badge-card" id="badgeEarlyBird">
              <div class="badge-icon">🌅</div>
              <div class="badge-name">Early Bird</div>
              <div class="badge-status" id="tagEarlyBird">Locked</div>
            </div>
            <div class="badge-card" id="badgeStreak">
              <div class="badge-icon">🔥</div>
              <div class="badge-name">On Fire</div>
              <div class="badge-status" id="tagStreak">Locked</div>
            </div>
            <div class="badge-card" id="badgeMaster">
              <div class="badge-icon">🎓</div>
              <div class="badge-name">Study Master</div>
              <div class="badge-status" id="tagMaster">Locked</div>
            </div>
            <div class="badge-card" id="badgeBalanced">
              <div class="badge-icon">⚖️</div>
              <div class="badge-name">Balanced Life</div>
              <div class="badge-status" id="tagBalanced">Locked</div>
            </div>
            <div class="badge-card" id="badgeNightOwl">
              <div class="badge-icon">🌙</div>
              <div class="badge-name">Night Owl</div>
